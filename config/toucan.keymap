#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FUN  3
#define SYS  4

// 36-key positions, used for positional hold-taps
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 25 26 27 28 29
#define THUMBS 30 31 32 33 34 35

&mt {
    quick-tap-ms = <100>;
    require-prior-idle-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <180>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <16 17>;  // J K
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <12 13>;  // D F
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <7 8>;  // I O
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
        };

        Hyper1 {
            bindings = <&kp LS(LA(LC(LG(NUMBER_1))))>;
            key-positions = <34 7 6>;  // BSPC thumb + I U
        };

        Hyper2 {
            bindings = <&kp LS(LA(LC(LG(NUMBER_2))))>;
            key-positions = <34 17 18>;  // BSPC thumb + K L
        };

        Hyper3 {
            bindings = <&kp LS(LA(LC(LG(NUMBER_3))))>;
            key-positions = <34 27 26>;  // BSPC thumb + , M
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys {
            if-layers = <SYM NAV>;
            then-layer = <SYS>;
        };
    };

    macros {
        LockScreen: LockScreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(Q))>;
            label = "LOCKSCREEN";
        };

        CloseWindow: CloseWindow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(W))>;
            label = "CLOSEWINDOW";
        };

        ScreenShoot: ScreenShoot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(NUMBER_4))>;
            label = "SCREENSHOOT";
        };

        ReviveWindow: ReviveWindow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(T))>;
            label = "REVIVEWINDOW";
        };

        Meh: Meh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(LEFT_CONTROL))>;
            label = "MEH";
        };

        QuitApp: QuitApp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(Q)>;
            label = "QUITAPP";
        };
    };

    behaviors {
        mt_hold: mt_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // urob's "timeless" hold-taps: a hold only counts when the next key is on the other hand
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        ltl: ltl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        ltr: ltr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
        // 36-key layout (5 columns + 3 thumb keys per side)
        // | lt3 TAB | W | E | R | T |   | Y | U | I | O | lt3 P |
        // | hm Meh A | hm Alt S | D | F | G |   | H | J | K | hm Alt L | hm Meh ' |
        // | hm Ctrl Z | hm Sft X | lt SYM C | V | B |   | N | M | lt SYM , | hm Sft . | hm Ctrl Q |
        //       | --- | mt_hold SFT ESC | mt GUI SPC |   | lt NAV ENT | lt SYM BSPC | --- |
        // Combos: J+K BSPC, D+F DEL, I+O ENT. Hold SYM + NAV for SYS.
        // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

        base_layer {
            display-name = "BASE";
            bindings = <
&lt FUN TAB                 &kp W              &kp E        &kp R                       &kp T                 &kp Y          &kp U                    &kp I            &kp O                &lt FUN P
&hml LS(LA(LEFT_CONTROL)) A &hml LEFT_ALT S    &kp D        &kp F                       &kp G                 &kp H          &kp J                    &kp K            &hmr LEFT_ALT L       &hmr LS(LA(LEFT_CONTROL)) SINGLE_QUOTE
&hml LEFT_CONTROL Z         &hml LEFT_SHIFT X  &ltl SYM C   &kp V                       &kp B                 &kp N          &kp M                    &ltr SYM COMMA   &hmr RIGHT_SHIFT DOT  &hmr LEFT_CONTROL Q
                                               &trans       &mt_hold LEFT_SHIFT ESCAPE  &mt LEFT_GUI SPACE    &lt NAV ENTER  &lt_repeat SYM BACKSPACE  &trans
            >;
        };

        // | @ | < | > | \ | | |   | ` | ( | ) | ~ | BSPC |
        // | ! | _ | - | = | & |   | # | { | } | / | ? |
        // | * | + | [ | ] | % |   | ^ | : | ; | $ | ¥ |
        //       | --- | mt SFT BSPC | --- |   | mo SYS | KP0 | --- |

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp AT           &kp LESS_THAN  &kp GREATER_THAN  &kp BACKSLASH             &kp PIPE       &kp GRAVE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE   &kp BACKSPACE
&kp EXCLAMATION  &kp UNDER      &kp MINUS         &kp EQUAL                 &kp AMPS       &kp HASH   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SLASH   &kp QUESTION
&kp STAR         &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET         &kp PERCENT    &kp CARET  &kp COLON             &kp SEMI               &kp DOLLAR  &kp INT_YEN
                                &trans            &mt LEFT_SHIFT BACKSPACE  &trans         &mo SYS    &kp KP_N0             &trans
            >;
        };

        // | 1 | 2 | 3 | 4 | 5 |   | 6 | 7 | 8 | 9 | 0 |
        // | --- | mt Alt HOME | mt Sft PgDn | PgUp | END |   | ← | ↓ | ↑ | → | --- |
        // | Ctrl | --- | --- | --- | --- |   | ScrL | ScrD | ScrU | ScrR | - |
        //       | --- | mt SFT BSPC | mt GUI SPC |   | --- | --- | --- |

        nav_layer {
            display-name = "NAV";
            bindings = <
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3              &kp NUMBER_4              &kp NUMBER_5          &kp NUMBER_6    &kp NUMBER_7    &kp NUMBER_8  &kp NUMBER_9     &kp NUMBER_0
&trans            &mt LEFT_ALT HOME  &mt LEFT_SHIFT PAGE_DOWN  &kp PAGE_UP               &kp END               &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&kp LEFT_CONTROL  &trans             &trans                    &trans                    &trans                &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &kp MINUS
                                     &trans                    &mt LEFT_SHIFT BACKSPACE  &mt LEFT_GUI SPACE    &trans          &trans          &trans
            >;
        };

        // | LockScr | CloseWin | mouse↑ | Screenshot | ReviveWin |   | --- | --- | --- | --- | Play/Pause |
        // | --- | mouse← | mouse↓ | mouse→ | QuitApp |   | --- | Prev | Next | --- | --- |
        // | --- | --- | --- | --- | --- |   | --- | Vol- | Vol+ | --- | --- |
        //       | MClick | LClick | RClick |   | --- | --- | --- |

        fun_layer {
            display-name = "FUN";
            bindings = <
&LockScreen  &CloseWindow    &mmv MOVE_UP    &ScreenShoot     &ReviveWindow    &trans  &trans             &trans           &trans  &kp K_PLAY_PAUSE
&trans       &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &QuitApp         &trans  &kp K_PREVIOUS     &kp K_NEXT       &trans  &trans
&trans       &trans          &trans          &trans           &trans           &trans  &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &trans  &trans
                             &mkp MCLK       &mkp LCLK        &mkp RCLK        &trans  &trans             &trans
            >;
        };

        // | BT1 | BT0 | BT clr all | BT clr | reset |   | BT0 | BT1 | BT2 | BT3 | BT4 |
        // | BT4 | BT3 | --- | bootload | OUT USB |   | --- | --- | --- | --- | --- |
        // | --- | --- | --- | studio_unlock | OUT BLE |   | OUT BLE | studio_unlock | reset | bootload | OUT USB |
        //       | --- | --- | --- |   | --- | --- | --- |

        sys_layer {
            display-name = "SYS";
            bindings = <
&bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR_ALL  &bt BT_CLR      &sys_reset    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&bt BT_SEL 4  &bt BT_SEL 3  &trans          &bootloader     &out OUT_USB  &trans        &trans          &trans        &trans        &trans
&trans        &trans        &trans          &studio_unlock  &out OUT_BLE  &out OUT_BLE  &studio_unlock  &sys_reset    &bootloader   &out OUT_USB
                            &trans          &trans          &trans        &trans        &trans          &trans
            >;
        };
    };
};
